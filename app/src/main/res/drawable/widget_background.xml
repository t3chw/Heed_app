<?xml version="1.0" encoding="utf-8"?>
<!--
  Heed widget background: the app's surface with a hairline border, so the widget reads as a card
  on any wallpaper. Colours come from values / values-night, so it follows light and dark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/heed_surface" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/heed_line" />
</shape>
