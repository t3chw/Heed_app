<?xml version="1.0" encoding="utf-8"?>
<!--
  Transparent vector for the Android 12+ system splash icon. The OS
  always paints SOMETHING in the splash centre; pointing it at a
  fully-transparent drawable hides the launcher icon, leaving only the
  matching window background visible for the brief moment before
  Compose paints.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0 H108 V108 H0 Z" />
</vector>
